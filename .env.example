# Copy to .env and fill in. Never commit .env.

# Free key from https://aistudio.google.com/apikey
# Note: on Google's free tier, your inputs may be used to improve Google's
# products. Don't upload private documents.
GEMINI_API_KEY=

# Change this to any long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=dev-secret-change-me-to-a-long-random-string

# --- LLM: any OpenAI-compatible endpoint ---------------------------------
# Gemini (default):
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
# Tried in order if the main model errors or times out (free-tier models get overloaded)
LLM_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.6-flash
LLM_TIMEOUT_SECONDS=30
# LLM_API_KEY defaults to GEMINI_API_KEY when empty
# LLM_API_KEY=
#
# Groq example:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_API_KEY=gsk_...
#
# Offline / load testing (no API calls, no key needed):
# LLM_PROVIDER=fake

# --- Embeddings -----------------------------------------------------------
# "gemini", or "fake" (keyword-hash vectors, no API calls)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
# Changing EMBEDDING_DIM after first run requires wiping the DB:
#   docker compose down -v
EMBEDDING_DIM=768

# --- Retrieval tuning -----------------------------------------------------
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=6
# Repeat each CSV's header row in every chunk
CSV_HEADER_IN_CHUNKS=true
# vector | keyword | hybrid (hybrid = both, merged with Reciprocal Rank Fusion)
RETRIEVAL_MODE=hybrid
# none | cross_encoder (local CPU model) | llm (extra Gemini call per question)
RERANKER=none
RERANK_CANDIDATES=20

# --- OCR (scanned PDFs and images) ------------------------------------------
# gemini (vision LLM, falls back to tesseract on error) | tesseract (local)
OCR_PROVIDER=gemini
OCR_MODEL=gemini-3.5-flash-lite
